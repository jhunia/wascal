---
import type { Partner } from '../data/partners';
interface Props { partners: Partner[]; label?: string }
const { partners, label = 'Partners' } = Astro.props;
// Logos first within each group, so the wall reads as a logo wall.
const sorted = [...partners].sort((a, b) => Number(!!b.logo) - Number(!!a.logo));
---
<ul class="wall notranslate" aria-label={label}>
  {sorted.map((p) => {
    const Tag = p.url ? 'a' : 'div';
    return (
      <li>
        <Tag class:list={['tile', { 'has-logo': !!p.logo }]} href={p.url} target={p.url ? '_blank' : undefined} rel={p.url ? 'noopener noreferrer' : undefined}
          title={p.url ? `${p.name} — official website (opens in a new tab)` : p.name}>
          {p.logo ? (
            <img src={p.logo} alt={p.name} loading="lazy" decoding="async" />
          ) : (
            <span class="wordmark" aria-label={p.name}>
              <span class="short" aria-hidden="true">{p.short || p.name}</span>
              <span class="full" aria-hidden="true">{p.name}</span>
            </span>
          )}
          {p.url && <span class="sr-only"> (opens in a new tab)</span>}
        </Tag>
      </li>
    );
  })}
</ul>

<style>
  .wall { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; }
  .tile { height: 120px; display: flex; align-items: center; justify-content: center; padding: 16px 18px; border: 1px solid var(--line); border-radius: 10px; background: var(--white); color: #2a3140; text-decoration: none; transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s; }
  a.tile:hover { border-color: var(--blue); box-shadow: var(--shadow); transform: translateY(-2px); color: #2a3140; }
  .tile img { max-height: 76px; max-width: 100%; width: auto; height: auto; object-fit: contain; }
  .wordmark { display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center; }
  .short { font-weight: 800; font-size: 20px; letter-spacing: 0.03em; line-height: 1.1; color: var(--blue-deep); }
  .full { font-size: 12px; color: var(--muted); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  @media (max-width: 640px) {
    .wall { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
    .tile { height: 76px; padding: 8px; border-radius: 8px; }
    .tile img { max-height: 46px; }
    .short { font-size: 13px; }
    .full { display: none; }
  }
  @media (max-width: 360px) { .wall { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>

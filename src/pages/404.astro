---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
---
<Base title="Page not found" noindex>
  <PageHeader title="We couldn't find that page" lead="It may have moved when the WASCAL website was redesigned." />
  <div class="wrap nf">
    <form action="/search/" method="get" role="search">
      <label for="nf-q">Search the site</label>
      <div class="row">
        <input id="nf-q" name="q" type="search" placeholder="e.g. doctoral programme" />
        <button class="btn btn-primary" type="submit">Search</button>
      </div>
    </form>
    <p>Or go to the <a href="/">homepage</a>, <a href="/news/">latest news</a> or <a href="/contact/">contact us</a>.</p>
  </div>
</Base>

<style>
  .nf { padding-block: 48px 96px; max-width: 720px; display: flex; flex-direction: column; gap: 24px; }
  label { font-weight: 600; }
  .row { display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap; }
  input { flex: 1 1 240px; min-height: 48px; padding: 0 12px; border: 1px solid var(--line-2); border-radius: 8px; font: inherit; }
</style>

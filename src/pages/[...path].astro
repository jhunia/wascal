---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PostCard from '../components/PostCard.astro';
import { pages, postsIn, childPages, tidyRole, personUrl, type Page } from '../lib/content';
import { sectionFor, type NavItem } from '../data/nav';
import { heroFor } from '../lib/heroes';

export function getStaticPaths() {
  // Paths the new site builds with its own templates.
  const CUSTOM = new Set(['/', '/news/', '/contact/', '/our-partners/', '/partners/', '/search/', '/alumni/']);
  return pages
    .filter((p) => !CUSTOM.has(p.path))
    .map((page) => ({ params: { path: page.path.replace(/^\/|\/$/g, '') }, props: { page } }));
}
const { page } = Astro.props as { page: Page };

const found = sectionFor(page.path);
const crumbs = found
  ? [...found.trail.slice(0, -1).map((t) => ({ label: t.label, href: t.href })), { label: page.title }]
  : [{ label: page.title }];

const list = page.list ? postsIn(page.list) : [];
const people = [...page.people].sort((a, b) => a.order - b.order);
const kids = childPages(page);
const htmlText = page.html.replace(/<[^>]+>/g, '').trim();
// People pages often only repeat the page title as a heading.
const showHtml = htmlText.length > 0 && !(people.length && htmlText.length < 60);
const isEmpty = !showHtml && !list.length && !people.length;

const sideItems: NavItem[] = found?.section.children ?? [];
---
<Base title={page.title} image={page.image} current={page.path}>
  <PageHeader title={page.title} crumbs={crumbs} eyebrow={found?.section.label} image={heroFor(page.path, found?.section.label)} />

  <div class:list={['wrap', 'page-layout', { 'has-side': sideItems.length > 0 }]}>
    {sideItems.length > 0 && (
      <aside class="side" aria-label={`${found!.section.label} pages`}>
        <p class="side-title">{found!.section.label}</p>
        <ul>
          {sideItems.map((item) => (
            <li>
              <a href={item.href} aria-current={item.href === page.path ? 'page' : undefined} rel={item.external ? 'noopener' : undefined}>{item.label}</a>
              {item.children && (
                <ul>{item.children.map((c) => <li><a href={c.href} aria-current={c.href === page.path ? 'page' : undefined}>{c.label}</a></li>)}</ul>
              )}
            </li>
          ))}
        </ul>
      </aside>
    )}

    <div class="page-main" data-pagefind-body>
      {showHtml && <div class="prose" set:html={page.html} />}

      {people.length > 0 && (
        <ul class="people">
          {people.map((p) => (
            <li>
              <a href={personUrl(p.slug)} class="person">
                {p.image ? <img src={p.image} alt="" loading="lazy" /> : <span class="person-ph" aria-hidden="true" />}
                <span class="person-name">{p.name}</span>
                <span class="person-role">{tidyRole(p.role)}</span>
              </a>
            </li>
          ))}
        </ul>
      )}

      {list.length > 0 && (
        <section class="list" aria-label={`${page.title}: latest`}>
          <div class="card-grid">{list.map((p) => <PostCard post={p} />)}</div>
        </section>
      )}

      {isEmpty && (
        <div class="empty">
          {kids.length > 0 ? (
            <>
              <p>This section includes:</p>
              <ul>{kids.map((k) => <li><a href={k.path}>{k.title}</a></li>)}</ul>
            </>
          ) : (
            <p>Content for this page is being prepared. Please check back soon, or <a href="/contact/">contact WASCAL</a>.</p>
          )}
        </div>
      )}
    </div>
  </div>
</Base>

<style>
  .page-layout { padding-block: 48px 80px; }
  .has-side { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 56px; align-items: start; }
  .side { position: sticky; top: 16px; border: 1px solid var(--line); border-radius: var(--radius); padding: 18px; font-size: 15px; }
  .side-title { font-weight: 700; color: var(--ink); margin-bottom: 8px; padding-inline: 10px; }
  .side ul { list-style: none; margin: 0; padding: 0; }
  .side ul ul { margin: 2px 0 6px 12px; border-left: 2px solid var(--line); padding-left: 6px; }
  .side a { display: block; padding: 7px 10px; border-radius: 8px; color: var(--ink-2); text-decoration: none; line-height: 1.35; }
  .side a:hover { background: var(--surface); color: var(--blue); }
  .side a[aria-current='page'] { background: var(--blue-tint); color: var(--blue-deep); font-weight: 600; }
  .page-main { min-width: 0; display: flex; flex-direction: column; gap: 40px; }
  .people { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px; }
  .person { display: flex; flex-direction: column; gap: 4px; text-decoration: none; color: var(--ink); }
  .person img, .person-ph { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%; border-radius: var(--radius); background: var(--surface); margin-bottom: 8px; display: block; }
  .person-name { font-weight: 700; line-height: 1.3; }
  .person:hover .person-name { color: var(--blue); }
  .person-role { font-size: 14.5px; color: var(--muted); }
  .empty { padding: 28px; border: 1px dashed var(--line-2); border-radius: var(--radius); color: var(--ink-2); }
  .empty ul { margin: 10px 0 0; }
  @media (max-width: 960px) {
    .has-side { grid-template-columns: 1fr; gap: 32px; }
    .side { position: static; order: 2; }
  }
</style>

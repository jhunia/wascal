---
import Base from '../../../../layouts/Base.astro';
import PageHeader from '../../../../components/PageHeader.astro';
import NewsListing from '../../../../components/NewsListing.astro';
import { categories, postsIn, PER_PAGE } from '../../../../lib/content';

export function getStaticPaths() {
  return categories.flatMap((c) => {
    const list = postsIn([c.slug]);
    const last = Math.max(1, Math.ceil(list.length / PER_PAGE));
    return Array.from({ length: last }, (_, i) => ({
      params: { cat: c.slug, page: i === 0 ? undefined : `page/${i + 1}` },
      props: { cat: c, list, n: i + 1, last },
    }));
  });
}
const { cat, list, n, last } = Astro.props;
const base = `/news/category/${cat.slug}/`;
---
<Base title={n > 1 ? `${cat.name} — page ${n}` : cat.name} current="/news/">
  <PageHeader title={cat.name} eyebrow="News topic" crumbs={[{ label: 'News', href: '/news/' }, { label: cat.name }]} lead={`${list.length} ${list.length === 1 ? 'story' : 'stories'}`} />
  <NewsListing posts={list.slice((n - 1) * PER_PAGE, n * PER_PAGE)} current={n} last={last} base={base} activeCategory={cat.slug} />
</Base>
